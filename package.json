{
  "name": "@elderlygate/ui-kit",
  "private": true,
  "description": "The org's shared UI kit: tokens, CSS, fonts, kit.js and thin React wrappers.",
  "type": "module",
  "exports": {
    "./css/kit.css": "./css/kit.css",
    "./css/tokens.css": "./css/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./js/kit.js": "./js/kit.js",
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    }
  },
  "files": ["css", "fonts", "js", "react/index.js", "react/index.d.ts", "tokens/tokens.json"],
  "sideEffects": ["*.css", "js/kit.js"],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "test": "node --test react/index.test.js react/confirm.test.js react/license.test.js test/kit.test.js && tsc -p react"
  }
}
